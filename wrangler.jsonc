{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reserva-de-produtos",
  "main": "src/worker.js",
  "compatibility_date": "2024-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vellumine-db",
      "database_id": "38698442-91c2-44a4-a577-cee0db48d212"
    }
  ]
}
